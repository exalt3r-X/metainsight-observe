{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/exalt3r-X/metainsight-observe/schemas/case.schema.json",
  "title": "Metainsight Observe — Scenario",
  "description": "A single sequential-uncertainty scenario. All scenarios share the same six-slot roles and four prediction types so results are comparable across domains.",
  "type": "object",
  "required": ["id", "theme", "title", "hook", "belief", "sources", "pred", "gut", "decisions", "facts", "truthNote"],
  "properties": {
    "id": { "type": "string", "description": "short slug, e.g. work" },
    "theme": { "type": "string" },
    "emoji": { "type": "string" },
    "title": { "type": "string" },
    "hook": { "type": "string", "description": "1-2 sentence framing" },
    "belief": { "type": "string", "description": "the tracked adverse belief, e.g. 'a colleague took credit deliberately'" },
    "sources": {
      "type": "object",
      "description": "exactly six fixed-role slots",
      "required": ["terminal", "gauge", "vent", "eng", "adm", "mara"],
      "additionalProperties": {
        "type": "object",
        "required": ["name", "kind", "observe", "interpret"],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["obs", "inf", "dep"], "description": "observation / inference / dependent-echo" },
          "observe": { "type": "string", "description": "raw fact" },
          "interpret": { "type": "string", "description": "assumption layered on the fact" }
        }
      }
    },
    "pred": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "dim", "text"],
        "properties": {
          "id": { "enum": ["outcome", "temporal", "causal", "intent"] },
          "dim": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "gut": {
      "type": "array",
      "description": "three pre-analysis impulses",
      "items": { "type": "object", "required": ["id", "label"], "properties": {
        "id": { "type": "string" }, "label": { "type": "string" }, "alarmy": { "type": "boolean" } } }
    },
    "decisions": {
      "type": "array",
      "description": "baseline action choices (aggressive/wait/info)",
      "items": { "type": "object", "required": ["id", "label"], "properties": {
        "id": { "type": "string" }, "label": { "type": "string" } } }
    },
    "facts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "description": "three facts revealed after the decision; item 3 may branch on the aggressive action"
    },
    "truthNote": { "type": "string", "description": "the resolution: temporal always false; intent never proven" }
  }
}
